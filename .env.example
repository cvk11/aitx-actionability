# Copy to .env and fill in. Never commit .env.
# --- Required for real inference (paid) ---
GEMINI_API_KEY=
# Gemini 4 Argon is the sole active provider; no Anthropic key is used.
# Arm C (independent OpenAI research) is a placeholder: not implemented, no OpenAI key is used.

# --- Pinned models (exact model version identifiers; never "latest" aliases) ---
AITX_PRIMARY_MODEL=gemini-4-argon
AITX_VERIFIER_MODEL=gemini-4-argon
AITX_EFFORT=high
AITX_VERIFIER_EFFORT=medium
# Server-side refusal fallback: OFF for the first controlled run (a fallback model would change the pinned model)
AITX_REFUSAL_FALLBACK=false

# --- Budgets / loop limits (first-run-safe values; owner budget ~32 USD) ---
# Application estimate only; review Google Cloud billing/quota controls. Budget alerts are not hard spending caps.
AITX_MAX_TOOL_ROUNDS=16
AITX_MAX_REVISIONS=2
AITX_MAX_COST_USD_PER_CASE=12
AITX_MAX_COST_USD_TOTAL=30
AITX_CALL_RESERVE_USD=0.25
AITX_MAX_ATTEMPTS=3
AITX_MAX_TOKENS=32768
# Supervised self-repair (scripts/run_supervised.py): fixer call budget per cycle
AITX_MAX_FIX_COST_USD=1.00

# --- Free public APIs (recommended: raises NCBI limit from 3 to 10 req/s) ---
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=aitx-actionability

# --- Privacy / deployment ---
# true on the Hugging Face Space: no disk cache, no run artifacts, no input/output logging
AITX_DEPLOYMENT_MODE=false
AITX_CACHE_DIR=data/cache
AITX_LOG_LEVEL=INFO
